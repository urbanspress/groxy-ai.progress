# Groxy AI v0.3.0 — Autonomous GRAB-DESIGN-SYSTEM.md Visual Generator Engine
# ---------------------------------------------------------------------------

make all_style_pack_specs
  set p1_light to record {bg: "#ffffff", surface: "#f8fafc", text: "#0f172a", primary: "#047857", on_primary: "#ffffff", border: "#cbd5e1", muted: "#475569"}
  set p1_dark to record {bg: "#0f172a", surface: "#1e293b", text: "#f8fafc", primary: "#34d399", on_primary: "#064e3b", border: "#334155", muted: "#cbd5e1"}
  set sp1 to record {id: "emerald-editorial", label: "Emerald Editorial", description: "High-contrast editorial typography, generous vertical rhythm (--grex-space-lg), emerald primary accents (--grex-primary), and structured Card callouts.", industries: ["editorial", "media", "consulting", "nonprofit", "docs"], conversion_goals: ["editorial", "lead_gen"], token_preferences: ["--grex-surface", "--grex-text", "--grex-primary", "--grex-space-lg", "--grex-radius-md"], class_hints: ["hero", "hero-card", "card", "btn-primary", "badge-pill", "grid-3", "cta-button"], light: p1_light, dark: p1_dark, space: "1.5rem", radius: "0.75rem"}
